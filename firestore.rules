rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function isActivePromotion() {
      return resource.data.activa == true && (
        resource.data.estado == 'aprobada' ||
        resource.data.estado == 'aprobado' ||
        resource.data.estado == 'activa' ||
        resource.data.estado == 'publicada'
      );
    }

    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.tipo == 'cliente'
        && request.resource.data.nombre is string
        && request.resource.data.email is string
        && request.resource.data.createdAt is timestamp;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    function isActiveCompany() {
      return resource.data.estado in ['aprobado', 'activa', 'publicada'];
    }

    match /empresa/{empresaId} {
      allow read: if isOwner(empresaId) || isAdmin() || resource.data.publico == true || isActiveCompany();
      allow create: if isOwner(empresaId)
        && request.resource.data.nombre is string
        && request.resource.data.email is string
        && request.resource.data.estado in ['pendiente', 'aprobado'];
      allow update: if isOwner(empresaId) || isAdmin();
      allow delete: if false;
    }

    match /admin/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false;
    }

    match /promociones/{promoId} {
      allow read: if isActivePromotion() || isOwner(resource.data.empresaId) || isAdmin();
      allow create: if isAuthenticated()
        && (request.auth.uid == request.resource.data.empresaId || isAdmin())
        && request.resource.data.empresaId is string
        && request.resource.data.titulo is string
        && request.resource.data.descripcion is string
        && request.resource.data.activa is bool
        && request.resource.data.estado is string
        && request.resource.data.createdAt is timestamp;
      // Las visualizaciones se incrementan solo desde la función callable segura,
      // no desde el cliente directo, para evitar spam de actualizaciones de contador.
      allow update: if isAdmin()
        || (isOwner(resource.data.empresaId)
          && request.resource.data.visualizaciones == resource.data.visualizaciones);
      allow delete: if isOwner(resource.data.empresaId) || isAdmin();
    }

    match /tickets/{ticketId} {
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.usuarioId
        && request.resource.data.usuarioId is string
        && request.resource.data.empresaId is string
        && request.resource.data.promocionId is string
        && request.resource.data.codigo is string
        && request.resource.data.estado is string
        && request.resource.data.createdAt is timestamp;
      allow read: if isOwner(resource.data.usuarioId) || isOwner(resource.data.empresaId);
      allow update: if isOwner(resource.data.empresaId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado',
          'redeemedAt',
          'expiredAt',
          'updatedAt',
          'recordatorioExpiracionEnviado',
          'recordatorioExpiracionEnviadoAt',
          'fechaCanjeado'
        ]);
      allow delete: if false;
    }

    match /favoritos/{favId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.usuarioId;
      allow read, delete: if isAuthenticated() && request.auth.uid == resource.data.usuarioId;
      allow update: if false;
    }

    function esPlanValido(planId, precio, monto) {
      return (planId == 'basico' && precio == 9.99 && monto == 9.99)
        || (planId == 'profesional' && precio == 24.99 && monto == 24.99)
        || (planId == 'empresarial' && precio == 99.99 && monto == 99.99);
    }

    match /pagos/{pagoId} {
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.empresaId
        && request.resource.data.empresaId is string
        && request.resource.data.planId is string
        && request.resource.data.status == 'espera'
        && request.resource.data.precio is number
        && request.resource.data.monto is number
        && esPlanValido(request.resource.data.planId, request.resource.data.precio, request.resource.data.monto);
      allow read: if isOwner(resource.data.empresaId) || isAdmin();
      allow update: if isAdmin();
    }

    match /suscripciones/{subId} {
      allow read: if isOwner(resource.data.empresaId) || isAdmin();
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.empresaId || isAdmin());
      allow update: if isAdmin();
    }

    match /referidos/{referralId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.usuarioId || resource.data.publico == true
      );
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.usuarioId
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() > 0
        && request.resource.data.creadoEn is timestamp
        && (!('publico' in request.resource.data) || request.resource.data.publico is bool);
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == resource.data.usuarioId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bonusEntregado', 'bonusEntregadoEn', 'bonusTipo', 'bonusDetalle', 'contadorReferidosAplicado'])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalReferidos'])
          && request.resource.data.totalReferidos == resource.data.totalReferidos + 1
          && exists(/databases/$(database)/documents/referidos/$(request.auth.uid))
          && get(/databases/$(database)/documents/referidos/$(request.auth.uid)).data.referidoPor == referralId
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalBonosEntregados'])
          && request.resource.data.totalBonosEntregados == resource.data.totalBonosEntregados + 1
          && exists(/databases/$(database)/documents/referidos/$(request.auth.uid))
          && get(/databases/$(database)/documents/referidos/$(request.auth.uid)).data.referidoPor == referralId
        )
      );
      allow delete: if false;
    }

    match /notificaciones/{notifId} {
      allow create: if isAuthenticated()
        && request.resource.data.usuarioId is string
        && (request.auth.uid == request.resource.data.usuarioId || isAdmin())
        && request.resource.data.tipo in ['nueva_promocion','promocion_vencimiento','promocion_vencida','ticket_canjeado','empresa_aprobada','empresa_rechazada','nueva_resena','bonus_referido','tickets_agotados']
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 200
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 1000
        && request.resource.data.leida == false;
      allow read, delete: if isAuthenticated() && request.auth.uid == resource.data.usuarioId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.usuarioId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
    }

    match /vistas/{vistaId} {
      allow create: if request.resource.data.promocionId is string
        && request.resource.data.promocionId.size() > 0
        && request.resource.data.empresaId is string
        && request.resource.data.empresaId.size() > 0
        && request.resource.data.timestamp is timestamp;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
