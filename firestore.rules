rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    // Usuarios: solo el propio usuario puede leer y escribir su documento
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Empresa: cualquiera puede leer, solo la empresa o admin puede escribir
    match /empresa/{empresaId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == empresaId || isAdmin());
    }

    // Admin docs: solo lectura del propio doc, nunca escritura desde cliente
    match /admin/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Tickets: cliente crea, cliente o empresa pueden leer, empresa puede canjear con campos restringidos
    match /tickets/{ticketId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.usuarioId;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.usuarioId || request.auth.uid == resource.data.empresaId
      );
      allow update: if request.auth != null
        && request.auth.uid == resource.data.empresaId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'fechaCanjeado']);
      allow delete: if false;
    }

    // Promociones: lectura pública, escritura por empresa dueña o admin; el contador público de visualizaciones se actualiza con update restringido
    match /promociones/{promoId} {
      allow read: if true;
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.empresaId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == resource.data.empresaId || isAdmin());
      allow update: if (request.auth != null && (request.auth.uid == resource.data.empresaId || isAdmin()))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visualizaciones']);
    }

    // Favoritos: solo el usuario puede manipular sus favoritos
    match /favoritos/{favId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.usuarioId;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.usuarioId;
    }

    // Pagos y suscripciones: lectura restringida (admin/empresa), escritura controlada
    match /pagos/{pagoId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.empresaId;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.empresaId || isAdmin()
      );
      allow update: if isAdmin();
    }

    match /suscripciones/{subId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.empresaId || isAdmin());
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.empresaId || isAdmin());
      allow update: if isAdmin();
    }

    // TODO: la creación cruzada de notificaciones cliente→empresa debería moverse a una Cloud Function en el futuro.
    match /notificaciones/{notifId} {
      allow create: if request.auth != null
        && request.resource.data.usuarioId is string
        && request.resource.data.tipo in ['nueva_promocion','promocion_vencimiento','promocion_vencida','ticket_canjeado','empresa_aprobada','empresa_rechazada','nueva_resena','bonus_referido','tickets_agotados']
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 200
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 1000
        && request.resource.data.leida == false;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.usuarioId;
      allow update: if request.auth != null && request.auth.uid == resource.data.usuarioId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
    }

    match /vistas/{vistaId} {
      allow create: if request.resource.data.promocionId is string
        && request.resource.data.promocionId.size() > 0
        && request.resource.data.empresaId is string
        && request.resource.data.empresaId.size() > 0
        && request.resource.data.timestamp is timestamp;
      allow read, update, delete: if false;
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
